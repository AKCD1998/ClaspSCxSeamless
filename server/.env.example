NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Preferred shared-backend naming used in production for this repo.
SC_OFFICIAL_SUPABASE_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>
SEAMLESS_DB_SCHEMA=clasp_scx_seamless

# Backward-compatible aliases still supported by the server.
DATABASE_URL=
DB_SCHEMA=
INTERNAL_API_TOKEN=

# HTTP Basic Auth for the whole app (React SPA + /api/app/* + /api/files/*) — required in
# production. When either is empty the app is WIDE OPEN with no auth at all (dev convenience
# only — a startup warning is logged when this happens). Bearer INTERNAL_API_TOKEN above also
# satisfies this check, so the print-agent keeps working without changes.
APP_BASIC_USER=
APP_BASIC_PASSWORD=

# Auto-print agent (docs/09-auto-print-agent-design.md) — Bearer token shared with print-agent/.
# ISO date; agent auto-prints only processing_records uploaded on/after this date. Old documents
# still need an admin-triggered print via the web button.
AUTO_PRINT_SINCE=

# LINE Messaging API — notifies the document group after a successful auto-print.
# Channel access token (long-lived) from LINE Developers Console > Messaging API.
LINE_CHANNEL_ACCESS_TOKEN=
# Channel secret, used to verify the x-line-signature header on POST /api/line/webhook.
LINE_CHANNEL_SECRET=
# groupId of the LINE group to push to — obtained once via the webhook log (see docs/09 section 4.3).
LINE_TARGET_ID=

# Optional pg connection variables if DATABASE_URL is not used.
PGHOST=localhost
PGPORT=5432
PGDATABASE=<DB_NAME>
PGUSER=<DB_USER>
PGPASSWORD=<DB_PASSWORD>

HEALTH_FAIL_ON_DB_ERROR=false

# File storage for generated XLSX and preview workbooks.
# STORAGE_DIR is used only when R2 below is not configured (local disk fallback for dev,
# and free-tier Render where disk is ephemeral).
STORAGE_DIR=storage
PUBLIC_BASE_URL=http://localhost:3001

# Cloudflare R2 — persistent storage for generated .xlsx/preview workbooks.
# Uses a dedicated bucket/prefix for this repo, separate from other repos in the workspace,
# so it stays isolated the same way SEAMLESS_DB_SCHEMA isolates the Postgres data.
# When these are unset, the server falls back to local disk (STORAGE_DIR above).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Object key prefix inside the bucket, so it's safe to share a bucket with other repos if needed.
R2_KEY_PREFIX=clasp-scx-seamless
# Only needed for path-style S3-compatible endpoints (e.g. local MinIO for testing). Leave unset for real R2.
R2_FORCE_PATH_STYLE=false

# Email delivery for "send document" feature (POST /api/files/:id/send-email).
# Uses SendGrid, same as the shared currentSC-official-website-project backend.
SENDGRID_API_KEY=
# MAIL_FROM must be a SendGrid-verified Single Sender or domain-authenticated address.
MAIL_FROM=
# Default recipient when the request does not specify a "to" address.
DOCS_RECIPIENT_EMAIL=
