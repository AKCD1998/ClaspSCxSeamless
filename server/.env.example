NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Prefer DATABASE_URL in production. Keep placeholders here and never commit real secrets.
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>

# Optional pg connection variables if DATABASE_URL is not used.
PGHOST=localhost
PGPORT=5432
PGDATABASE=<DB_NAME>
PGUSER=<DB_USER>
PGPASSWORD=<DB_PASSWORD>

HEALTH_FAIL_ON_DB_ERROR=false

# Local file storage for generated XLSX and preview workbooks.
STORAGE_DIR=storage
PUBLIC_BASE_URL=http://localhost:3001
