NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Preferred shared-backend naming used in production for this repo.
SC_OFFICIAL_SUPABASE_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>
SEAMLESS_DB_SCHEMA=clasp_scx_seamless

# Backward-compatible aliases still supported by the server.
DATABASE_URL=
DB_SCHEMA=
INTERNAL_API_TOKEN=

# Optional pg connection variables if DATABASE_URL is not used.
PGHOST=localhost
PGPORT=5432
PGDATABASE=<DB_NAME>
PGUSER=<DB_USER>
PGPASSWORD=<DB_PASSWORD>

HEALTH_FAIL_ON_DB_ERROR=false

# Local file storage for generated XLSX and preview workbooks.
STORAGE_DIR=storage
PUBLIC_BASE_URL=http://localhost:3001
